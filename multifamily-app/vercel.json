{
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/(.*)\\.(css|js|png|jpg|svg|woff2)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/dashboard", "dest": "/index.html" },
    { "src": "/return-to-dashboard.html", "dest": "/return-to-dashboard.html" },
    { "src": "/manifest.json", "dest": "/api/manifest.js" },
    { "src": "^/static/(.*)", "dest": "/static/$1" },
    { "src": "/(.*)\\.js$", "dest": "/$1.js" },
    { "src": "/(.*)\\.css$", "dest": "/$1.css" },
    { "src": "/(.*)\\.png$", "dest": "/$1.png" },
    { "src": "/(.*)\\.svg$", "dest": "/$1.svg" },
    { "src": "/(.*)\\.html$", "dest": "/$1.html" },
    { "src": "/(.*)\\.json$", "dest": "/$1.json" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
