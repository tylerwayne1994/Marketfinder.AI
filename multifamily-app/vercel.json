{
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/manifest.json", "dest": "/api/manifest.js" },
    { "src": "^/static/(.*)", "dest": "/static/$1" },
    { "src": "/(.*)\\.js$", "dest": "/$1.js" },
    { "src": "/(.*)\\.css$", "dest": "/$1.css" },
    { "src": "/(.*)\\.png$", "dest": "/$1.png" },
    { "src": "/(.*)\\.svg$", "dest": "/$1.svg" },
    { "src": "/(.*)\\.json$", "dest": "/$1.json" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
